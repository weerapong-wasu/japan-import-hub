---
interface Props {
  href: string;
  title: string;
  description: string;
  category: 'games' | 'music' | 'figures';
  emoji: string;
  date: Date;
}
const { href, title, description, category, emoji, date } = Astro.props;
const badgeClass = `badge badge-${category}`;
const labels = { games: 'Import Games', music: 'J-Pop & Music', figures: 'Figures & Merch' };
const label = labels[category];
---
<article class="card">
  <span class="emoji">{emoji}</span>
  <span class={badgeClass}>{label}</span>
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  <span class="meta">{date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
</article>
