---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AffiliateCta from '../components/AffiliateCta.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => !data.draft && data.category === 'figures'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base title="Anime Figures & Merch" description="Guides for buying authentic anime figures, Nendoroids, scale figures and Japanese merchandise: spotting bootlegs, pre-order timing, and where to buy.">
  <section class="hero">
    <div class="container">
      <h1>Figures &amp; <em>Merch</em></h1>
      <p class="lead">
        Scale figures, Nendoroids, plushies and official goods — how to pre-order authentic
        merchandise directly from Japan and never pay bootleg prices.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>All Figure &amp; Merch Guides</h2>
      <div class="grid">
        {articles.map((a) => (
          <ArticleCard
            href={`/guides/${a.id}`}
            title={a.data.title}
            description={a.data.description}
            category={a.data.category}
            emoji={a.data.heroEmoji}
            date={a.data.pubDate}
          />
        ))}
      </div>

      <AffiliateCta
        store="playasia"
        heading="Browse figures & collectibles on Play-Asia"
        text="Official anime figures, game merchandise and Japan-exclusive collectibles with worldwide shipping."
        path="/toys"
      />
    </div>
  </section>
</Base>
