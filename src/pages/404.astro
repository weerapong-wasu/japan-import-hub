---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page moved or never existed — but our import guides are still here.">
  <section class="hero" style="padding: 64px 0;">
    <div class="container" style="text-align:center;">
      <p class="badge badge-figures" style="margin-bottom:14px;">404</p>
      <h1>Lost in <em>transit</em>.</h1>
      <p class="lead" style="margin-left:auto;margin-right:auto;">
        That page doesn't exist (or got renamed) — but the guides you're
        probably here for are one click away.
      </p>
      <a href="/" class="btn btn-primary">Back to homepage</a>
      <a href="/toolkit" class="btn btn-ghost">See the Import Toolkit</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Popular starting points</h2>
      <div class="grid" style="margin-top: 18px;">
        <a class="card" href="/games">
          <span class="emoji">🎮</span>
          <h3>Import Games</h3>
          <p>Region-free consoles, Japan-exclusive titles, safe ordering.</p>
        </a>
        <a class="card" href="/music">
          <span class="emoji">💿</span>
          <h3>J-Pop &amp; Music</h3>
          <p>First press CDs, city pop vinyl, and how to tell editions apart.</p>
        </a>
        <a class="card" href="/figures">
          <span class="emoji">🗿</span>
          <h3>Figures &amp; Merch</h3>
          <p>Spotting bootlegs and buying scale figures with confidence.</p>
        </a>
      </div>
    </div>
  </section>
</Base>
