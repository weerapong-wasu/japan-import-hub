---
import Base from '../layouts/Base.astro';
---
<Base title="Affiliate Disclosure" description="How affiliate links work on Japan Import Hub.">
  <div class="container">
    <header class="article-header">
      <h1>Affiliate Disclosure</h1>
    </header>
    <article class="prose">
      <p>
        Japan Import Hub participates in the affiliate programs of
        <strong>Play-Asia</strong> and <strong>CDJapan (Neowing)</strong>.
      </p>
      <p>
        When you click a link on this site that leads to one of these stores and make a purchase,
        we may receive a commission from the store. This happens at <strong>no additional cost to you</strong> —
        prices are identical whether you use our link or not.
      </p>
      <p>
        We only recommend stores we would use ourselves, and our guides are written independently.
        Commissions never determine what we write or which products we cover.
      </p>
      <p>
        Links to affiliate partners are marked with <code>rel="sponsored"</code> in accordance with
        search engine guidelines, and this disclosure is linked from every article.
      </p>
    </article>
  </div>
</Base>
