---
import Base from '../../layouts/Base.astro';
import AffiliateCta from '../../components/AffiliateCta.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, category, pubDate, heroEmoji } = article.data;
const badgeClass = `badge badge-${category}`;
const labels = { games: 'Import Games', music: 'J-Pop & Music', figures: 'Figures & Merch' };
const label = labels[category];

// Global SEO: Article + BreadcrumbList structured data → rich results
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: title,
      description,
      datePublished: pubDate.toISOString(),
      dateModified: (article.data.updatedDate ?? pubDate).toISOString(),
      image: new URL('/og-image.png', Astro.site).href,
      mainEntityOfPage: canonical,
      inLanguage: 'en',
      author: { '@type': 'Organization', name: 'Japan Import Hub', url: Astro.site?.href },
      publisher: { '@id': new URL('/#organization', Astro.site).href },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
        { '@type': 'ListItem', position: 2, name: label, item: new URL(`/${category}`, Astro.site).href },
        { '@type': 'ListItem', position: 3, name: title, item: canonical },
      ],
    },
  ],
});
---
<Base title={title} description={description} type="article">
  <script slot="head" type="application/ld+json" set:html={articleSchema} />
  <div class="container">
    <header class="article-header">
      <span class={badgeClass}>{label}</span>
      <h1>{heroEmoji} {title}</h1>
      <p class="date">
        Published {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
    </header>

    <div class="disclosure">
      <strong>Affiliate disclosure:</strong> this article contains affiliate links to Play-Asia and/or CDJapan.
      If you buy through them we may earn a small commission at no extra cost to you. It keeps these guides free for everyone.
    </div>

    <article class="prose">
      <Content />
    </article>

    {category === 'games' && (
      <AffiliateCta
        store="playasia"
        heading="Browse import games on Play-Asia"
        text="Worldwide shipping, English store, new and pre-owned Japanese & Asia releases."
        path="/games"
      />
    )}
    {category === 'music' && (
      <AffiliateCta
        store="cdjapan"
        heading="Order Japanese music on CDJapan"
        text="CDs, vinyl, Blu-rays and first-press editions shipped directly from Japan."
        path="/"
      />
    )}
    {category === 'figures' && (
      <AffiliateCta
        store="playasia"
        heading="Browse figures & collectibles on Play-Asia"
        text="Official anime figures, game merchandise and Japan-exclusive collectibles, shipped worldwide."
        path="/toys"
      />
    )}
  </div>
</Base>
