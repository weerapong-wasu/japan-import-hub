# ============================================================
# JAPAN IMPORT HUB — Environment Variables
# Copy to `.env` for local dev. On Vercel: Project → Settings →
# Environment Variables (add each one for Production + Preview).
# The site BUILDS AND RUNS WITHOUT any of these — Stripe/newsletter
# features simply show a "not configured yet" message until set.
# ============================================================

# ---- Stripe (dashboard.stripe.com → Developers → API keys) ----
# Use test keys (sk_test_...) first. Switch to live keys when ready.
STRIPE_SECRET_KEY=
# Created in: Developers → Webhooks → Add endpoint
#   URL: https://YOUR-DOMAIN/api/stripe-webhook
#   Events: checkout.session.completed
STRIPE_WEBHOOK_SECRET=
# Price ID of the Toolkit product (Products → Add product → copy price_...)
STRIPE_TOOLKIT_PRICE_ID=

# ---- Supabase (supabase.com → Project → Settings → API) ----
SUPABASE_URL=
# Service role key — SERVER ONLY, never expose in client code
SUPABASE_SERVICE_ROLE_KEY=
# Public (anon) key — safe for the browser, protected by RLS.
# Needed for member login + wishlist on /account.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# ---- Site ----
# Full public URL of the deployed site, no trailing slash
PUBLIC_SITE_URL=http://localhost:4321
